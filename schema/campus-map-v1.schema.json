{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus map App export, format version 1",
  "description": "The decompressed content of campus-map/v1/campus-map.json.gz. Format, field rules and versioning: docs/campus-map-export.md. References, coordinates, closed rings and sizes are checked by scripts/validate_campus_map.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "attribution", "buildings", "units", "amenities", "linework", "rooms", "aliases"],
  "properties": {
    "formatVersion": {"const": 1},
    "attribution": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "contains": {"const": "© OpenStreetMap contributors (ODbL)"},
      "uniqueItems": true
    },
    "buildings": {"type": "array", "items": {"$ref": "#/$defs/building"}},
    "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
    "amenities": {"type": "array", "items": {"$ref": "#/$defs/amenity"}},
    "linework": {"type": "array", "items": {"$ref": "#/$defs/linework"}},
    "rooms": {"type": "array", "items": {"$ref": "#/$defs/room"}},
    "aliases": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "unitId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(#[2-9]|#[1-9][0-9]+)?$"},
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ja"],
      "properties": {"ja": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}}
    },
    "position": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
    "lineString": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/position"}},
    "ring": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/position"}},
    "polygon": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ring"}},
    "multiPolygon": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/polygon"}},
    "building": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "campus", "name", "codes", "center", "footprint", "levels", "entrances"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "campus": {"enum": ["ookayama", "suzukakedai"]},
        "name": {"$ref": "#/$defs/name"},
        "codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "center": {"$ref": "#/$defs/position"},
        "footprint": {"$ref": "#/$defs/multiPolygon"},
        "levels": {"type": "array", "items": {"$ref": "#/$defs/level"}},
        "entrances": {"type": "array", "items": {"$ref": "#/$defs/entrance"}}
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ordinal", "name", "outline"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "ordinal": {"type": "integer"},
        "name": {"type": "string", "minLength": 1},
        "outline": {"$ref": "#/$defs/multiPolygon"}
      }
    },
    "entrance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "point", "name", "levelId"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "point": {"$ref": "#/$defs/position"},
        "name": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/name"}]},
        "levelId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "levelId", "category", "roomId", "label", "center", "polygon"],
      "properties": {
        "id": {"$ref": "#/$defs/unitId"},
        "levelId": {"$ref": "#/$defs/id"},
        "category": {"enum": ["classroom", "room", "corridor", "elevator_lobby", "restroom", "stairs", "lounge", "porch"]},
        "roomId": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "label": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "center": {"$ref": "#/$defs/position"},
        "polygon": {"$ref": "#/$defs/polygon"}
      }
    },
    "amenity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "levelId", "category", "point"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "levelId": {"$ref": "#/$defs/id"},
        "category": {"enum": ["elevator", "stairs", "restroom", "restroom.male", "restroom.female", "restroom.wheelchair",
                              "aed", "lounge", "lounge.women", "lounge.international", "rest_room", "calm_down", "study_room"]},
        "point": {"$ref": "#/$defs/position"}
      }
    },
    "linework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levelId", "tone", "widthM", "lines"],
      "properties": {
        "levelId": {"$ref": "#/$defs/id"},
        "tone": {"enum": ["wall", "detail"]},
        "widthM": {"type": "number", "minimum": 0},
        "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lineString"}}
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "buildingId", "unitIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "code": {"type": "string", "minLength": 1},
        "buildingId": {"$ref": "#/$defs/id"},
        "unitIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/unitId"}}
      }
    }
  }
}
