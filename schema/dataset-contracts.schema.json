{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasets"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "datasets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
      "additionalProperties": {"$ref": "#/$defs/dataset"}
    }
  },
  "$defs": {
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glob", "pathPattern", "schema", "versionField", "pathValueField", "index", "requiredFiles"],
      "properties": {
        "glob": {"type": "string", "minLength": 1},
        "pathPattern": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "pattern": "^schema/[a-z0-9{}-]+\\.schema\\.json$"},
        "versionField": {"type": "string", "minLength": 1},
        "pathValueField": {"type": "string", "minLength": 1},
        "index": {
          "type": "object",
          "additionalProperties": false,
          "required": ["group", "field", "multiple"],
          "properties": {
            "group": {"type": "string", "minLength": 1},
            "field": {"type": ["string", "null"], "minLength": 1},
            "multiple": {"type": "boolean"}
          }
        },
        "requiredFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
