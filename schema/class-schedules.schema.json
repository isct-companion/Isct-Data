{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campus Life class session schedules v1",
  "description": "Per-date sessions of courses that do not meet every week, such as the alternating red/white groups of 物理学演習 and 物理学実験.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "academicYear",
    "timezone",
    "source",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "academicYear": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2200
    },
    "timezone": {
      "const": "Asia/Tokyo"
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ja"
      ],
      "properties": {
        "ja": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "landingPageUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "publishedAt": {
          "type": "string",
          "format": "date"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "courseCode",
        "offeringIds",
        "quarters",
        "sourceIds",
        "sessions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "courseCode": {
          "type": "string",
          "pattern": "^[A-Z]{3}\\.[A-Z]\\d{3}$"
        },
        "classLabel": {
          "$ref": "#/$defs/localized"
        },
        "offeringIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\d+$"
          }
        },
        "quarters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "1Q",
              "2Q",
              "3Q",
              "4Q"
            ]
          }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/session"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "kind"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/date"
        },
        "kind": {
          "enum": [
            "orientation",
            "exercise",
            "lab",
            "exam",
            "no-class"
          ]
        },
        "group": {
          "enum": [
            "red",
            "white"
          ]
        },
        "number": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "exercise",
              "lab"
            ]
          }
        }
      },
      "then": {
        "required": [
          "group"
        ]
      },
      "else": {
        "not": {
          "required": [
            "group"
          ]
        }
      }
    }
  }
}
