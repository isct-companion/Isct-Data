# The model key for the four public datasets (the syllabus reader does not use a model).
OPENAI_API_KEY=
OPENAI_TERRA_MODEL=gpt-6.1-terra
OPENAI_SOL_MODEL=gpt-6.1-sol
OPENAI_RUN_TOKEN_LIMIT=240000
# The Isct-Data GitHub App (Contents: read and write); its key is var/github-app/private-key.pem.
ISCT_GITHUB_APP_ID=
ISCT_GITHUB_INSTALLATION_ID=
